# ============================================================
# Backend Spring INM5151 — modele de configuration.
# Copie-le en .env :   cp .env.example .env
# .env est ignore par Git : ne committe JAMAIS de vraie valeur secrete.
# ============================================================

ENVIRONMENT=development

# --- Base de donnees PostgreSQL ---
# Avec docker compose, l'hote est le nom du service "db" (port interne 5432).
DATABASE_URL=jdbc:postgresql://db:5432/scan
DATABASE_USER=scan
DATABASE_PASSWORD=scan
# Hors docker (jar lance en local), le port HOTE est 5433 (voir docker-compose.yml) :
# DATABASE_URL=jdbc:postgresql://localhost:5433/scan

# --- Open Food Facts : User-Agent OBLIGATOIRE (sinon throttling/ban de l'IP) ---
OFF_USER_AGENT=INM5151-ScanApp/0.1 (contact: equipe@courrier.uqam.ca)

# ============================================================
# Secrets — laisser VIDE ici pour .env.example.
# Valeur reelle : dans .env (local), via Render (prod), via GitHub Secrets (CI).
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
FDC_API_KEY=DEMO_KEY

# --- Chiffrement des donnees sensibles (journal digestif) ---
# Doit faire au moins 32 caracteres. NE PAS reutiliser jwt.secret.
# Changer cette valeur invalide les donnees chiffrees existantes.
ENCRYPTION_MASTER_KEY=***************************

# --- JWT ---
# Doit faire au moins 32 caracteres pour HMAC-SHA256.
JWT_SECRET=***************************
