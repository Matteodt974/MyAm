# ============================================================
# Backend INM5151 — modèle de configuration.
# Copie-le en .env :   cp .env.example .env     (Windows: copy .env.example .env)
# .env est ignoré par Git : ne committe JAMAIS de vraie valeur secrète.
# ============================================================

ENVIRONMENT=development

# --- Base de données PostgreSQL ---
# Avec docker compose, l'hôte est le nom du service "db".
DATABASE_URL=postgresql://scan:scan@db:5432/scan
# Hors docker (uvicorn lancé en local), remplace "db" par "localhost" :
# DATABASE_URL=postgresql://scan:scan@localhost:5432/scan

# --- Services internes (noms de service docker-compose) ---
OCR_URL=http://ocr:8001
TRANSLATE_URL=http://libretranslate:5000

# --- Open Food Facts : User-Agent OBLIGATOIRE (sinon throttling/ban de l'IP) ---
# Mets un contact d'équipe identifiable.
OFF_USER_AGENT=INM5151-ScanApp/0.1 (contact: equipe@courrier.uqam.ca)

# ============================================================
# Secrets À VENIR (sprints 1-2) — laisser VIDE ici.
# Valeur réelle : en local dans .env / en prod via Render / en CI via GitHub Secrets.
# ============================================================
# JWT_SECRET=
# DEEPL_API_KEY=
# LOGMEAL_API_KEY=
