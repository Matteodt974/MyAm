# Build multi-stage : on a besoin de .mvn/, mvnw, pom.xml et src/ uniquement.
# On exclut surtout target/ (artefacts Maven déjà présents en local) et .env.

# Artefacts de build Maven (recompilés dans le stage build)
target/

# Secrets - ne JAMAIS embarquer dans l'image
.env
.env.*
!.env.example

# Git / IDE / OS
.git
.gitignore
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
.DS_Store

# Logs
*.log

# Doc / orchestration (non utilisés par le build d'image)
README.md
docker-compose.yml
