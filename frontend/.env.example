# Local Flutter run configuration.
# Copy to .env and adjust for your machine.

# Full URL form:
BACKEND_URL=http://10.0.2.2:8545

# Temporary until the authenticated user's ID is read from the JWT.
PARENT_USER_ID=1

# Or host/IP form:
# BACKEND_HOST=192.168.2.10
# BACKEND_PORT=8082
# BACKEND_SCHEME=http
