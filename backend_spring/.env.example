# ============================================================
# Backend Spring INM5151 — modele de configuration.
# Copie-le en .env :   cp .env.example .env     (Windows: copy .env.example .env)
# .env est ignore par Git : ne committe JAMAIS de vraie valeur secrete.
# ============================================================

ENVIRONMENT=development

# --- Base de donnees PostgreSQL ---
# Avec docker compose, l'hote est le nom du service "db" (port interne 5432).
DATABASE_URL=postgresql://scan:scan@db:5432/scan
# Hors docker (jar lance en local), le port HOTE est 5433 (voir docker-compose.yml) :
# DATABASE_URL=postgresql://scan:scan@localhost:5433/scan

# --- Services internes (noms de service docker-compose) ---
OCR_URL=http://ocr:8001
TRANSLATE_URL=http://libretranslate:5000

# --- Open Food Facts : User-Agent OBLIGATOIRE (sinon throttling/ban de l'IP) ---
# Mets un contact d'equipe identifiable.
OFF_USER_AGENT=INM5151-ScanApp/0.1 (contact: equipe@courrier.uqam.ca)

# ============================================================
# Secrets A VENIR (sprints 1-2) — laisser VIDE ici.
# Valeur reelle : en local dans .env / en prod via Render / en CI via GitHub Secrets.
# ============================================================
# JWT_SECRET=
# DEEPL_API_KEY=
# LOGMEAL_API_KEY=
